# Stress Detection System - Environment Variables Template
# Copy this file to .env and fill in your values
# For Render deployment, add these as 'Environment Variables' in the Render dashboard

# Security
DJANGO_SECRET_KEY=%aqq#n7siqhaibsmfl*&+e+i@zmh%$dx%6993osb%7mnmxwh2=
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (PostgreSQL URI from Supabase or Neon)
# Format: postgres://user:password@hostname:port/dbname
DATABASE_URL=postgres://your_user:your_password@your_hostname:5432/your_db

# Static Files
# Whitenoise is used to serve static files
PYTHON_VERSION=3.10.0
